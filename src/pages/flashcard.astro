---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/topbar/TopbarApp.astro';
import Footer from '../components/footer/Footer.astro';
import contentHtml from '../content/pages/flashcard.html?raw';
---
<BaseLayout title="Flashcard — Rohit Builds">
  <Topbar slot="topbar" variant="flashcard" backHref="/" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<style>

.nav-links a:hover,.nav-links a.active{color:#1e293b;background:rgba(30,41,59,.06)}

@media(min-width:992px){}

@media(max-width:768px){.nav-dropdown.open }

/* Brand Type Scale */

/* Topbar — light, compact */

.mini-level{display:flex;align-items:center;gap:4px;padding:2px 8px;border-radius:999px;background:linear-gradient(135deg,#667eea,#764ba2);cursor:pointer;touch-action:manipulation;transition:.15s;flex-shrink:0}
.mini-level:active{transform:scale(.95)}
.mini-level .ml-num{font-size:11px;font-weight:800;color:#fff}
.mini-level .ml-gems{font-size:10px;font-weight:700;color:#fbbf24}

.nav-links a.active{color:#f59e0b;background:rgba(245,158,11,.1)}
/* Container */
.container{max-width:100%;margin:0 auto;padding:0 8px;display:flex;flex-direction:column;flex:1;min-height:0}

/* Narrative Banner */
.narrative-banner{margin:2px auto 0;padding:3px 8px;border-radius:8px;background:linear-gradient(135deg, rgba(192,132,252,.1), rgba(251,191,36,.06));border:1px solid rgba(192,132,252,.15);display:flex;align-items:center;gap:4px;font-size:10px}
.narrative-banner .narr-icon{font-size:18px}
.narrative-banner .narr-text{flex:1;color:#475569}
.narrative-banner .narr-text strong{color:#7c3aed}
.narrative-banner .narr-stage{font-size:10px;color:#94a3b8;font-weight:600}

/* Topic Grid — Cards */
.topic-area{flex:1;display:flex;flex-direction:column;justify-content:flex-start;align-items:center;padding:4px 0}
.topic-heading{font-size:22px;font-weight:800;color:#1e293b;margin-bottom:2px;text-align:center;line-height:1.2}

.topic-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:6px;width:100%;max-width:600px;margin:0 auto}
.topic-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:10px 8px;cursor:pointer;transition:.2s;text-align:center;touch-action:manipulation;-webkit-tap-highlight-color:transparent;position:relative;min-height:56px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}
.topic-card:active{transform:scale(.96);border-color:#a5b4fc;box-shadow:0 2px 8px rgba(99,102,241,.1)}
.topic-card .tc-icon{font-size:20px}
.topic-card .tc-name{font-size:11px;font-weight:700;color:#1e293b;line-height:1.2}
.topic-card .tc-due{position:absolute;top:-4px;right:-4px;background:#ef4444;color:#fff;font-size:10px;font-weight:700;border-radius:999px;padding:1px 6px;min-width:18px;height:18px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(239,68,68,.3)}
.topic-card.recent{border-color:#a5b4fc;background:rgba(99,102,241,.04)}
.topic-card.special{border-color:#f59e0b;background:rgba(245,158,11,.04);animation:specialPulse 2s ease-in-out infinite}
@keyframes specialPulse{0%,100%{box-shadow:0 0 0 rgba(245,158,11,0)}50%{box-shadow:0 0 6px rgba(245,158,11,.2)}}
.topic-card .special-badge{font-size:9px;background:#f59e0b;color:#fff;border-radius:999px;padding:1px 4px;position:absolute;bottom:-4px;right:-4px}

/* Flashcard Area */
.flashcard-area{display:none;flex-direction:column;flex:1;padding:0}
.flashcard-area.visible{display:flex}
/* Tracking bar above card */
.tracking-bar{flex-shrink:0;display:flex;flex-direction:column;gap:0;padding:0 12px}
.tracking-chips{display:flex;gap:4px;justify-content:center;margin-top:1px}
.tchip{display:inline-flex;align-items:center;gap:2px;padding:1px 6px;border-radius:999px;background:#f1f5f9;font-size:10px;font-weight:700;color:#64748b;cursor:pointer;touch-action:manipulation;transition:.15s}
.tchip:active{background:#e2e8f0;transform:scale(.95)}
.tchip-val{color:#1e293b;font-weight:800}

/* Power-up icon row (mystery, booster) */
.power-row{flex-shrink:0;display:flex;gap:4px;justify-content:center;padding:2px 0}
.pwr-btn{width:28px;height:28px;border-radius:50%;border:none;font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s;touch-action:manipulation;background:#f1f5f9;color:#64748b}
.pwr-btn:active{transform:scale(.88);background:#e2e8f0}
.pwr-btn:disabled{opacity:.3;cursor:default;transform:none}
.pwr-btn.active{background:linear-gradient(135deg,#ec4899,#db2777);color:#fff}

/* Timer row */
.timer-row{flex-shrink:0;display:flex;gap:4px;justify-content:center;align-items:center;padding:1px 0}
.timer-display{font-size:13px;font-weight:800;color:#6366f1;font-variant-numeric:tabular-nums;min-width:44px;text-align:center;letter-spacing:.5px}
.timer-display.urgent{color:#dc2626;animation:timerPulse .5s ease infinite}
@keyframes timerPulse{0%,100%{opacity:1}50%{opacity:.4}}

.action-btn:disabled{opacity:.4;cursor:not-allowed}

/* Card — Instagram Reel inspired */
.card-section{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0 auto;width:100%}
.card-wrapper{perspective:1200px;margin:0 auto;width:100%;cursor:pointer;position:relative;padding:24px 0}
.card-inner{position:relative;width:100%;min-height:240px;max-height:80vh;transition:transform .5s cubic-bezier(.4,0,.2,1);transform-style:preserve-3d;border-radius:20px}
.card-inner.flipped{transform:rotateX(180deg)}
.card-face{position:absolute;inset:0;-webkit-backface-visibility:hidden;backface-visibility:hidden;border-radius:20px;padding:24px 16px;display:flex;flex-direction:column;justify-content:center;border:1px solid rgba(0,0,0,.06)}
.card-front{background:linear-gradient(135deg,#e0e7ff,#c7d2fe);box-shadow:0 4px 20px rgba(99,102,241,.15);color:#1e1b4b;align-items:center}
.card-front .card-label{color:#6366f1}
.card-back{background:linear-gradient(135deg,#d1fae5,#a7f3d0);transform:rotateX(180deg);box-shadow:0 4px 20px rgba(16,185,129,.15);color:#064e3b}
.card-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#6b7280;text-align:center;flex-shrink:0}
.card-label.front{color:#6366f1}
.card-label.back{color:#059669}
.card-front .card-text{font-size:20px;font-weight:700;line-height:1.5;text-align:center;max-width:90%}
.card-back .card-text{font-size:15px;line-height:1.6;text-align:center;padding:0 8px}
.card-back .card-text code{background:rgba(5,150,105,.1);padding:1px 4px;border-radius:3px;font-size:13px}
.card-nav-btn{position:absolute;left:50%;transform:translateX(-50%);z-index:10;width:36px;height:36px;border-radius:50%;border:none;background:#fff;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.08);color:#64748b;touch-action:manipulation;transition:.15s}
.card-nav-btn:active{transform:translateX(-50%) scale(.88)}
.card-nav-prev{top:2px}
.card-nav-next{bottom:2px}
.card-hint{font-size:10px;color:#94a3b8;text-align:center;margin-top:4px;flex-shrink:0}

/* Instagram Reel layout: card + right action column */
.reel-layout{flex:1;display:flex;gap:6px;align-items:center;justify-content:center;padding:0 4px;width:100%;max-width:600px;margin:0 auto}
.card-section{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
/* Reel right action column (like Instagram) */
.reel-actions{flex-shrink:0;display:flex;flex-direction:column;gap:10px;padding:4px 2px;align-items:center}
.reel-action-btn{width:44px;height:44px;border-radius:50%;border:none;background:#fff;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.2s;touch-action:manipulation;box-shadow:0 2px 8px rgba(0,0,0,.08);color:#64748b;position:relative}
.reel-action-btn:active{transform:scale(.85);box-shadow:0 2px 12px rgba(0,0,0,.12)}
.reel-action-btn .rab-label{position:absolute;bottom:-14px;font-size:8px;font-weight:600;color:#94a3b8;white-space:nowrap;letter-spacing:.3px}
.reel-action-btn.liked{color:#ef4444;background:#fef2f2;animation:likePop .3s ease}
@keyframes likePop{0%{transform:scale(1)}50%{transform:scale(1.2)}100%{transform:scale(1)}}
.reel-action-btn.saved{color:#6366f1;background:#eef2ff}
.reel-action-btn.rewound{color:#d97706;background:#fffbeb}

/* Reel bottom bar — tier selector + srs info */
.reel-bottom{flex-shrink:0;display:flex;flex-direction:column;gap:4px;padding:4px 8px;width:100%;max-width:600px;margin:0 auto}
.reel-bottom .tier-row{display:flex;gap:8px;width:100%;align-items:center;justify-content:center}
.reel-bottom .tier-btn{flex:1;max-width:120px;padding:8px 0;border:none;border-radius:999px;font-size:12px;font-weight:700;cursor:pointer;transition:.2s;touch-action:manipulation;min-height:34px;opacity:.5;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.reel-bottom .tier-btn.active{opacity:1;transform:scale(1.03);box-shadow:0 2px 8px rgba(0,0,0,.08)}
.reel-bottom .tier-btn:active{transform:scale(.95)}
.tier-normal{background:linear-gradient(135deg,#eff6ff,#dbeafe);color:#2563eb;border:1px solid rgba(59,130,246,.2)}
.tier-normal.active{background:linear-gradient(135deg,#dbeafe,#bfdbfe)}
.tier-hard{background:linear-gradient(135deg,#fffbeb,#fef3c7);color:#d97706;border:1px solid rgba(245,158,11,.2)}
.tier-hard.active{background:linear-gradient(135deg,#fef3c7,#fde68a)}
.tier-expert{background:linear-gradient(135deg,#faf5ff,#f3e8ff);color:#7c3aed;border:1px solid rgba(147,51,234,.2)}
.tier-expert.active{background:linear-gradient(135deg,#f3e8ff,#e9d5ff)}
.srs-state{text-align:center;font-size:10px;font-weight:600;color:#64748b;flex-shrink:0}
.card-inner.lucky{animation:luckyGlow 1s ease}
@keyframes luckyGlow{0%,100%{box-shadow:0 0 0 rgba(255,215,0,0)}50%{box-shadow:0 0 30px rgba(255,215,0,.3)}}
/* Float XP */
.float-xp{position:absolute;font-weight:900;font-size:20px;pointer-events:none;z-index:100;animation:floatUp 1s ease forwards;text-shadow:0 0 10px currentColor}
@keyframes floatUp{0%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-60px) scale(1.2)}}
.float-xp.green{color:#059669}
.float-xp.orange{color:#d97706}
.float-xp.purple{color:#7c3aed}
.float-xp.gold{color:#f59e0b}
.float-xp.pink{color:#ec4899}
.float-xp.blue{color:#3b82f6}

.due-badge{display:inline-flex;align-items:center;justify-content:center;background:#ef4444;color:#fff;font-size:11px;font-weight:700;border-radius:999px;padding:2px 6px;min-width:20px;height:20px;margin-left:4px;vertical-align:middle}
.counter{text-align:center;font-size:10px;font-weight:600;color:#94a3b8;flex-shrink:0}
.progress-bar-wrap{height:3px;background:#e2e8f0;border-radius:3px;overflow:hidden;flex-shrink:0}
.progress-bar-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,#6366f1,#8b5cf6);transition:width .4s ease}
.spinner{display:inline-block;width:12px;height:12px;border:2px solid rgba(99,102,241,.2);border-top-color:#6366f1;border-radius:50%;animation:spin .6s linear infinite;vertical-align:middle;margin-right:4px}
@keyframes spin{to{transform:rotate(360deg)}}

/* Toast */
.toast{position:fixed;bottom:max(20px,env(safe-area-inset-bottom,20px));left:50%;transform:translateX(-50%);z-index:100000;padding:8px 16px;border-radius:999px;font-weight:700;font-size:12px;display:none;white-space:nowrap;box-shadow:0 4px 16px rgba(0,0,0,.1)}
.toast.show{display:block;animation:toastIn .3s ease}
.toast.success{background:#059669;color:#fff}
.toast.error{background:#dc2626;color:#fff}
.toast.info{background:#4f46e5;color:#fff}
.toast.xp{background:#d97706;color:#fff}
.toast.gem{background:#db2777;color:#fff}
@keyframes toastIn{0%{opacity:0;transform:translateX(-50%)translateY(10px)}100%{opacity:1;transform:translateX(-50%)translateY(0)}}

/* Confetti, Modals, Achievement Toast */
#confettiCanvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:99999}
.modal-overlay{position:fixed;inset:0;z-index:200000;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.5);backdrop-filter:blur(4px)}
.modal-overlay.show{display:flex}
.modal-box{background:#fff;border-radius:24px;padding:24px 20px;max-width:340px;text-align:center;box-shadow:0 0 60px rgba(99,102,241,.1);border:1px solid #e2e8f0;animation:modalIn .4s cubic-bezier(.4,0,.2,1)}
@keyframes modalIn{0%{transform:scale(.8);opacity:0}100%{transform:scale(1);opacity:1}}
.modal-box .big-lvl{font-size:56px;font-weight:900;background:linear-gradient(135deg,#f59e0b,#ef4444);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1}
.modal-box .big-lvl-title{font-size:20px;font-weight:800;color:#1e293b;margin-top:4px}
.modal-box .big-lvl-desc{font-size:12px;color:#64748b;margin-top:6px;line-height:1.5}
.modal-box button{margin-top:12px;padding:8px 24px;border:none;border-radius:999px;background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;font-size:13px;font-weight:700;cursor:pointer;transition:.2s}
.modal-box button:active{transform:scale(.97)}
.achiev-toast{position:fixed;top:60px;right:8px;z-index:150000;padding:8px 12px;border-radius:12px;max-width:260px;background:#fff;border:1px solid #e2e8f0;box-shadow:0 4px 20px rgba(0,0,0,.08);display:none;animation:achievSlide .4s cubic-bezier(.4,0,.2,1)}
.achiev-toast.show{display:block}
@keyframes achievSlide{0%{transform:translateX(120%);opacity:0}100%{transform:translateX(0);opacity:1}}
.achiev-toast .achiev-icon{font-size:22px}
.achiev-toast .achiev-title{font-size:12px;font-weight:800;color:#7c3aed}
.achiev-toast .achiev-desc{font-size:10px;color:#64748b}
.deck-complete{display:none;text-align:center;padding:16px;margin:8px 0;border-radius:16px;background:rgba(5,150,105,.06);border:1px solid rgba(5,150,105,.15);animation:deckCompIn .4s ease}
.deck-complete.show{display:block}
@keyframes deckCompIn{0%{transform:scale(.9);opacity:0}100%{transform:scale(1);opacity:1}}
.deck-complete .dc-icon{font-size:36px}
.deck-complete .dc-title{font-size:16px;font-weight:800;color:#059669}
.deck-complete .dc-sub{font-size:11px;color:#64748b}
.deck-complete .dc-xp{font-size:13px;font-weight:700;color:#d97706}
/* Lucky card notification */
.lucky-notice{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:90000;padding:14px 20px;border-radius:16px;background:#fff;border:2px solid #fbbf24;box-shadow:0 0 40px rgba(251,191,36,.15);text-align:center;display:none;animation:luckyPop .4s ease}
.lucky-notice.show{display:block}
@keyframes luckyPop{0%{transform:translate(-50%,-50%) scale(.5);opacity:0}100%{transform:translate(-50%,-50%) scale(1);opacity:1}}
.lucky-notice .ln-icon{font-size:36px}
.lucky-notice .ln-text{font-size:16px;font-weight:800;color:#d97706}
.lucky-notice .ln-sub{font-size:12px;color:#64748b}

/* Tool icons in topbar */
.tool-icons{display:flex;gap:2px;margin-left:auto}
.tool-icons span{font-size:16px;cursor:pointer;padding:4px 6px;border-radius:6px;transition:.15s;touch-action:manipulation}
.tool-icons span:active{background:#e2e8f0;transform:scale(.9)}

/* Popup overlay (replaces slide panel) */
.popup-overlay{position:fixed;inset:0;z-index:50000;background:rgba(0,0,0,.3);display:none;animation:fadeIn .15s ease}
.popup-overlay.open{display:block}
.popup-box{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:50001;background:#fff;border-radius:16px;max-width:92vw;width:400px;max-height:80vh;display:none;flex-direction:column;box-shadow:0 8px 40px rgba(0,0,0,.12);animation:popIn .2s ease}
.popup-box.open{display:flex}
.popup-header{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid #e2e8f0;flex-shrink:0}
.popup-title{font-size:14px;font-weight:700;color:#1e293b}
.popup-close{background:none;border:none;font-size:20px;color:#94a3b8;cursor:pointer;padding:4px 8px;border-radius:6px}
.popup-close:active{background:#f1f5f9}
.popup-
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes popIn{from{opacity:0;transform:translate(-50%,-50%) scale(.92)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}

/* Weekly Summary (Level 2: Scaffolding) */
.weekly-summary{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:180000;padding:20px 24px;border-radius:20px;background:#fff;border:2px solid rgba(99,102,241,.2);box-shadow:0 0 40px rgba(99,102,241,.08);text-align:center;display:none;animation:wsPop .4s ease;min-width:280px}
.weekly-summary.show{display:block}
@keyframes wsPop{0%{transform:translate(-50%,-50%) scale(.8);opacity:0}100%{transform:translate(-50%,-50%) scale(1);opacity:1}}
.weekly-summary .ws-icon{font-size:36px}
.weekly-summary .ws-title{font-size:16px;font-weight:800;color:#6366f1;margin-top:4px}
.weekly-summary .ws-row{display:flex;justify-content:center;gap:16px;margin:12px 0}
.weekly-summary .ws-item{text-align:center}
.weekly-summary .ws-item .ws-num{font-size:20px;font-weight:900;color:#d97706}
.weekly-summary .ws-item .ws-label{font-size:11px;color:#94a3b8;font-weight:600}
.weekly-summary .ws-change{font-size:13px;font-weight:700;margin-top:4px}
.weekly-summary .ws-change.up{color:#059669}
.weekly-summary .ws-change.down{color:#dc2626}
.weekly-summary button{margin-top:12px;padding:8px 24px;border-radius:999px;border:none;background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;font-size:12px;font-weight:700;cursor:pointer;transition:.2s}

/* Tutorial card at bottom */
.tut-card{display:none;margin:10px auto 0;max-width:480px;border-radius:12px;background:#fff;border:1px solid #e2e8f0;box-shadow:0 2px 12px rgba(0,0,0,.06);padding:12px 16px 10px;position:relative;flex-shrink:0}
.tut-card.show{display:block}
.tut-card .tut-close{position:absolute;top:6px;right:8px;background:none;border:none;font-size:16px;color:#94a3b8;cursor:pointer;padding:2px 6px;border-radius:6px;line-height:1}
.tut-card .tut-close:active{background:#f1f5f9}
.tut-card .tut-step{font-size:10px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px}
.tut-card .tut-icon{font-size:24px;margin:4px 0 0}
.tut-card .tut-title{font-size:14px;font-weight:800;color:#1e293b;margin:2px 0}
.tut-card .tut-desc{font-size:11px;color:#64748b;line-height:1.5;margin-bottom:6px}
.tut-card .tut-actions{display:flex;gap:6px;justify-content:flex-end}
.tut-card .tut-actions button{padding:5px 12px;border-radius:999px;font-size:11px;font-weight:700;border:none;cursor:pointer;transition:.15s}
.tut-card .tut-skip{background:#f1f5f9;color:#64748b}
.tut-card .tut-skip:active{background:#e2e8f0}
.tut-card .tut-next,.tut-card .tut-done{background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff}
.tut-card .tut-next:active,.tut-card .tut-done:active{opacity:.85}

/* Topic heading H1 */
.topic-heading{font-size:28px;font-weight:800;color:#1e293b;margin-bottom:8px;text-align:center;line-height:1.3}
/* Study topic H1 above card */
.study-topic{font-size:22px;font-weight:800;text-align:center;color:#4f46e5;margin-bottom:2px;padding:2px 0;line-height:1.2;flex-shrink:0}
/* ── Mobile-first responsive breakpoints ── */
/* Base = mobile (320px+), progressive enhancement at wider widths */

@media(min-width:768px){

.reel-layout{max-width:560px}
.card-inner{min-height:280px;max-height:82vh}
.reel-action-btn{width:44px;height:44px;font-size:20px}
.modal-box{margin:0 auto;max-width:340px}
}

@media(min-width:1024px){
.narrative-banner{font-size:12px;padding:6px 12px;gap:6px}
.narrative-banner .narr-stage{font-size:11px}
.topic-heading{font-size:28px;margin-bottom:4px}
.topic-grid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;max-width:650px}
.topic-card{padding:16px 14px;min-height:90px}
.topic-card .tc-icon{font-size:28px}
.topic-card .tc-name{font-size:13px}
.back-topics button{font-size:11px;padding:4px 12px}
.reel-layout{max-width:600px}
.card-inner{min-height:320px;max-height:84vh}
.card-face{padding:32px 24px}
.card-label{font-size:10px;letter-spacing:1px}
.card-front .card-text{font-size:22px;line-height:1.5}
.card-back .card-text{font-size:16px;line-height:1.6}
.card-back .card-text code{font-size:13px;padding:2px 6px}
