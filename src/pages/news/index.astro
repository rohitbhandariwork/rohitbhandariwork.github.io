---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Topbar from '../../components/topbar/Topbar.astro';
import Footer from '../../components/footer/Footer.astro';
import contentHtml from '../../content/pages/news.html?raw';
---
<BaseLayout title="News — Rohit Builds">
  <Topbar slot="topbar" active="news" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<style>

.main { max-width: 1200px; margin: 0 auto; padding: 24px 20px 60px; }

        .hero-edition {
            background: linear-gradient(135deg, var(--dark) 0%, #1e293b 100%);
            border-radius: 24px;
            padding: 48px 40px;
            margin-bottom: 40px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .hero-edition::before {
            content: '';
            position: absolute;
            top: -40%;
            right: -20%;
            width: 300px;
            height: 300px;
            background: rgba(102, 126, 234, .15);
            border-radius: 50%;
        }
        .hero-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--indigo);
            margin-bottom: 12px;
            position: relative;
        }
        .hero-title {
            font-family: var(--font-editorial);
            font-size: clamp(28px, 5vw, 42px);
            font-weight: 800;
            margin-bottom: 20px;
            position: relative;
        }
        .hero-title a { color: #fff; text-decoration: none; }
        .hero-title a:hover { text-decoration: underline; }
        .hero-headlines {
            list-style: none;
            margin-bottom: 28px;
            position: relative;
        }
        .hero-headlines li {
            font-size: 16px;
            color: #cbd5e1;
            padding: 8px 0 8px 24px;
            position: relative;
            line-height: 1.5;
        }
        .hero-headlines li::before {
            content: "";
            position: absolute;
            left: 0;
            top: 16px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--indigo);
        }
        .hero-meta {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 24px;
            position: relative;
        }

        .section-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--indigo);
            margin-bottom: 16px;
            padding-left: 4px;
        }

        .edition-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
            margin-bottom: 40px;
        }
        .edition-card {
            display: block;
            background: #fff;
            border: 2px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            text-decoration: none;
            transition: .2s;
        }
        .edition-card:active { transform: scale(.98); }
        .edition-card:hover { border-color: var(--indigo); box-shadow: 0 4px 12px rgba(102, 126, 234, .15); }
        .edition-date {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--indigo);
            margin-bottom: 10px;
        }
        .edition-headlines {
            list-style: none;
        }
        .edition-headlines li {
            font-size: 14px;
            color: var(--text-secondary);
            padding: 4px 0 4px 16px;
            position: relative;
            line-height: 1.4;
        }
        .edition-headlines li::before {
            content: "";
            position: absolute;
            left: 0;
            top: 11px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--text-muted);
        }

        .older-section { margin-bottom: 40px; }
        .older-list { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
        .older-list a {
            display: inline-block;
            padding: 8px 16px;
            background: #fff;
            border: 2px solid var(--border);
            border-radius: 999px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: .2s;
        }
        .older-list a:hover { border-color: var(--indigo); color: var(--indigo); }

        .sidebar { display: flex; flex-direction: column; gap: 20px; margin-top: 32px; }
        .sidebar-card {
            background: #fff;
            border: 2px solid var(--border);
            border-radius: 16px;
            padding: 20px;
        }
        .sidebar-title {
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--text);
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 2px solid var(--indigo);
        }
        .sidebar-text { font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
        .sidebar-archive { list-style: none; }
        .sidebar-archive li { border-bottom: 1px solid #f1f5f9; }
        .sidebar-archive li:last-child { border: none; }
        .sidebar-archive a {
            display: block;
            padding: 10px 0;
            color: var(--indigo);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }
        .sidebar-archive a:hover { text-decoration: underline; }
        .sidebar-ad {
            background: #f1f5f9;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            padding: 32px 16px;
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
        }

        @media (min-width: 768px) {
            .content-layout { display: grid; grid-template-columns: 1fr 280px; gap: 32px; }
            .sidebar { margin-top: 0; }
        }
        @media (max-width: 640px) {
            .hero-edition { padding: 32px 20px; }
            .hero-title { font-size: 28px; }
            .edition-grid { grid-template-columns: 1fr; }
        }
    
</style>
