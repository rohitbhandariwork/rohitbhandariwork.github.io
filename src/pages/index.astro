---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/topbar/Topbar.astro';
import Footer from '../components/footer/Footer.astro';
import contentHtml from '../content/pages/portfolio.html?raw';
---
<BaseLayout title="Rohit Builds — Azure Data Engineer & Builder">
  <Topbar slot="topbar" active="home" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<style>

}
h1,h2,h3,h4,h5,h6{font-family:var(--font-display);font-weight:700;line-height:1.2;color:var(--slate-900)}
h1{font-size:var(--text-3xl);font-weight:800}
h2{font-size:var(--text-2xl)}
h3{font-size:var(--text-xl)}
h4{font-family:var(--font-primary);font-size:var(--text-lg);font-weight:600}
h5{font-family:var(--font-primary);font-size:var(--text-md);font-weight:600}
a{color:var(--indigo);text-decoration:none;transition:color .2s}
a:hover{color:var(--deep-indigo)}
img{max-width:100%;height:auto}
.container{width:100%;max-width:1140px;margin:0 auto;padding:0 20px}
.row{display:flex;flex-wrap:wrap;margin:0 -12px}
.row>[class*="col-"]{padding:0 12px}
.col-lg-5,.col-lg-6,.col-lg-7{width:100%}
@media(min-width:992px){.col-lg-5{width:41.66%}.col-lg-6{width:50%}.col-lg-7{width:58.33%}}
.d-flex{display:flex}.flex-column{flex-direction:column}.justify-content-center{justify-content:center}.align-items-center{align-items:center}
.gy-5>*+*{margin-top:40px}
.g-4>*+*{margin-top:24px}
.img-fluid{max-width:100%;height:auto}

@media(max-width:768px){.nav-dropdown.open .col-lg-5,.col-lg-6,.col-lg-7{width:100%}}

.hero-section{position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:center;background:linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#0f172a 100%);color:#fff;overflow:hidden;padding:100px 0 60px}
.hero-orb{position:absolute;border-radius:50%;filter:blur(80px);opacity:.3}
.hero-orb-one{width:500px;height:500px;background:var(--indigo);top:-100px;right:-100px}
.hero-orb-two{width:400px;height:400px;background:var(--violet);bottom:-80px;left:-80px}
.top-bar{display:flex;align-items:center;gap:12px;margin-bottom:40px}
.brand-mark{font-family:var(--font-display);font-size:var(--text-xl);font-weight:800;background:linear-gradient(135deg,var(--indigo),var(--violet));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.top-bar-copy{font-size:var(--text-sm);color:var(--slate-400);font-weight:500}
.hero-shell{position:relative;z-index:1}
.eyebrow{display:inline-block;font-size:var(--text-xs);font-weight:600;text-transform:uppercase;letter-spacing:1.5px;color:var(--indigo);margin-bottom:16px;padding:6px 14px;border:1px solid rgba(102,126,234,.3);border-radius:999px}
.hero-section h1{font-size:clamp(28px,4vw,var(--text-4xl));font-weight:800;line-height:1.1;margin-bottom:20px;color:#fff}
.hero-lead{font-size:var(--text-lg);color:var(--slate-400);line-height:1.7;margin-bottom:32px;max-width:600px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:32px}
/* ── Hero/Contact Button Overrides (dark backgrounds) ── */
.hero-actions .btn-primary,
.contact-actions .btn-primary {
  background: #fff;
  color: var(--indigo);
  padding: 14px 28px;
  font-size: var(--text-md);
  border-radius: 999px;
  min-height: 48px;
}
.hero-actions .btn-primary:hover,
.contact-actions .btn-primary:hover {
  box-shadow: 0 8px 24px rgba(0,0,0,.2);
  transform: translateY(-1px);
}
.btn-hero {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 28px;
  background: transparent;
  color: #fff;
  border: 1.5px solid rgba(255,255,255,.3);
  border-radius: 999px;
  font-weight: 600;
  font-size: var(--text-md);
  font-family: var(--font-primary);
  transition: all .2s;
  cursor: pointer;
  min-height: 48px;
}
.btn-hero:hover {
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.5);
  color: #fff;
}
.hero-microcopy{display:flex;flex-wrap:wrap;gap:16px;margin-bottom:40px}
.hero-microcopy span{display:inline-flex;align-items:center;gap:6px;font-size:var(--text-sm);color:var(--slate-400)}
.hero-microcopy svg.bi{color:var(--indigo)}
.hero-stats{display:flex;gap:16px;flex-wrap:wrap}
.mini-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:20px;flex:1;min-width:240px}
.mini-label{font-size:var(--text-xs);text-transform:uppercase;letter-spacing:1px;color:var(--indigo);font-weight:600;display:block;margin-bottom:8px}
.mini-card strong{font-size:var(--text-lg);color:#fff;display:block;margin-bottom:8px}
.mini-card p{font-size:var(--text-sm);color:var(--slate-400);line-height:1.5;margin:0}
.portrait-panel{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:24px;overflow:hidden}
.portrait-frame{position:relative;overflow:hidden;aspect-ratio:4/5}
.profile-photo{width:100%;height:100%;object-fit:cover}
.portrait-summary{padding:24px}
.portrait-summary h2{font-size:var(--text-lg);color:#fff;margin-bottom:12px}
.portrait-summary p{font-size:var(--text-sm);color:var(--slate-400);margin-bottom:16px}
.social-links{display:flex;gap:10px}
.social-links a{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:rgba(255,255,255,.08);color:var(--slate-400);font-size:18px;transition:all .2s}
.social-links a:hover{background:var(--indigo);color:#fff}
.social-links a.linkedin:hover{background:#0077b5}
.social-links a.github:hover{background:#333}
.social-links a.email:hover{background:var(--violet)}

#main{padding:80px 0}
.section-shell{padding:80px 0}
.section-soft{background:var(--slate-100)}
.section-intro{max-width:700px;margin-bottom:48px}
.section-intro.compact-intro{margin-bottom:32px}
.section-kicker{font-size:var(--text-xs);text-transform:uppercase;letter-spacing:1.5px;color:var(--indigo);font-weight:600;display:block;margin-bottom:12px}
.section-intro h2{margin-bottom:16px}
.section-intro p{font-size:var(--text-lg);color:var(--slate-500);line-height:1.7}

.feature-panel{background:#fff;border:1px solid var(--slate-200);border-radius:20px;padding:32px}
.feature-panel h3{margin-bottom:16px}
.feature-panel>p{color:var(--slate-500);margin-bottom:24px;line-height:1.7}
.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.feature-item{display:flex;gap:12px;padding:16px;background:var(--slate-50);border-radius:12px;border:1px solid var(--slate-200)}
.feature-item svg.bi{font-size:24px;color:var(--indigo);flex-shrink:0;margin-top:2px}
.feature-item strong{display:block;font-size:var(--text-md);margin-bottom:4px;color:var(--slate-900)}
.feature-item p{font-size:var(--text-sm);color:var(--slate-500);margin:0;line-height:1.5}
@media(max-width:768px){.feature-grid{grid-template-columns:1fr}}

.identity-panel{background:linear-gradient(135deg,var(--indigo),var(--violet));border-radius:20px;padding:32px;color:#fff}
.identity-panel .mini-label{color:rgba(255,255,255,.7)}
.fact-stack{display:flex;flex-direction:column;gap:16px}
.fact-row{display:flex;justify-content:space-between;align-items:center;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,.15)}
.fact-row:last-child{border-bottom:none;padding-bottom:0}
.fact-row span{font-size:var(--text-sm);color:rgba(255,255,255,.7)}
.fact-row strong{font-size:var(--text-md);font-weight:600}
.fact-row a{color:#fff;text-decoration:underline}

.proof-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
.proof-card{background:#fff;border:1px solid var(--slate-200);border-radius:16px;padding:24px;transition:transform .2s,box-shadow .2s}
.proof-card:hover{transform:translateY(-4px);box-shadow:0 12px 24px rgba(0,0,0,.08)}
.proof-value{font-family:var(--font-display);font-size:var(--text-xs);font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--indigo);background:rgba(102,126,234,.1);padding:4px 10px;border-radius:6px;display:inline-block;margin-bottom:12px}
.proof-card h3{font-size:var(--text-lg);margin-bottom:8px}
.proof-card p{font-size:var(--text-sm);color:var(--slate-500);line-height:1.6;margin:0}

.case-study-grid{display:grid;gap:24px}
.case-study-card{background:#fff;border:1px solid var(--slate-200);border-radius:20px;padding:32px;transition:transform .2s}
.case-study-card:hover{transform:translateY(-2px)}
.case-study-featured{border-left:4px solid var(--indigo)}
.case-tag{font-size:var(--text-xs);font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--indigo);display:block;margin-bottom:12px}
.case-study-card h3{font-size:var(--text-xl);margin-bottom:12px}
.case-problem{color:var(--slate-500);line-height:1.7;margin-bottom:16px}
.case-study-card ul{list-style:none;padding:0}
.case-study-card li{position:relative;padding-left:20px;margin-bottom:8px;font-size:var(--text-sm);color:var(--slate-700);line-height:1.6}
.case-study-card li::before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;background:var(--indigo);border-radius:50%}

.timeline-panel{background:#fff;border:1px solid var(--slate-200);border-radius:20px;padding:32px;height:100%}
.resume-title{font-size:var(--text-xl);margin-bottom:24px;padding-bottom:12px;border-bottom:2px solid var(--slate-200)}
.resume-item{margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--slate-100)}
.resume-item:last-child{margin-bottom:0;padding-bottom:0;border-bottom:none}
.resume-item h4{margin-bottom:4px}
.resume-item h5{font-size:var(--text-sm);color:var(--indigo);font-weight:600;margin-bottom:4px}
.resume-item p{font-size:var(--text-sm);color:var(--slate-500);margin-bottom:8px}
.resume-item em{font-style:italic;color:var(--slate-700)}
.resume-item ul{list-style:none;padding:0}
.resume-item li{position:relative;padding-left:16px;margin-bottom:6px;font-size:var(--text-sm);color:var(--slate-700);line-height:1.5}
.resume-item li::before{content:"";position:absolute;left:0;top:8px;width:5px;height:5px;background:var(--indigo);border-radius:50%}

.contact-banner{background:linear-gradient(135deg,var(--indigo),var(--violet));border-radius:24px;padding:48px;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:32px;margin-bottom:48px;flex-wrap:wrap}
.contact-banner h2{color:#fff;margin-bottom:12px}
.contact-banner p{color:rgba(255,255,255,.8);font-size:var(--text-lg);max-width:600px}
.contact-banner .section-kicker{color:rgba(255,255,255,.7)}
.contact-actions{display:flex;gap:12px;flex-shrink:0}
.contact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.contact-item{display:flex;align-items:center;gap:12px;padding:16px;background:#fff;border:1px solid var(--slate-200);border-radius:12px;transition:transform .2s}
.contact-item:hover{transform:translateY(-2px)}
.contact-item svg.bi{font-size:20px;color:var(--indigo);flex-shrink:0}
.contact-item span{font-size:var(--text-xs);text-transform:uppercase;letter-spacing:1px;color:var(--slate-400);font-weight:600;display:block;margin-bottom:2px}
.contact-item a{font-size:var(--text-sm);color:var(--slate-700);font-weight:500}

#footer{background:var(--slate-900);color:#fff;padding:48px 0;text-align:center}
#footer h3{font-size:var(--text-xl);color:#fff;margin-bottom:8px}
#footer p{color:var(--slate-400);font-size:var(--text-sm);margin-bottom:20px}
#footer .social-links{justify-content:center}
#footer .social-links a{display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.1)}
#footer .social-links a:hover{background:var(--indigo)}

.back-to-top{display:flex;align-items:center;justify-content:center;position:fixed;bottom:24px;right:24px;width:44px;height:44px;background:var(--indigo);color:#fff;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;opacity:0;visibility:hidden;transition:all .3s;z-index:9999;box-shadow:0 4px 12px rgba(102,126,234,.4)}
.back-to-top.visible{opacity:1;visibility:visible}
.back-to-top:hover{background:var(--deep-indigo);color:#fff;transform:translateY(-2px)}

#preloader{position:fixed;inset:0;z-index:99999;background:var(--slate-50);display:flex;align-items:center;justify-content:center;transition:opacity .4s}
#preloader.loaded{opacity:0;pointer-events:none}

#nl-overlay{position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,.45);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden;transition:opacity .4s,visibility .4s}
#nl-overlay.show{opacity:1;visibility:visible}
#nl-modal{background:#fff;border-radius:24px;padding:44px 40px 36px;max-width:440px;width:92%;position:relative;text-align:center;box-shadow:0 30px 70px rgba(0,0,0,.15)}
#nl-close{position:absolute;top:14px;right:18px;background:none;border:none;color:var(--slate-400);font-size:26px;cursor:pointer;padding:4px;line-height:1;transition:color .2s}
#nl-close:hover{color:var(--slate-900)}
#nl-icon{width:48px;height:52px;background:linear-gradient(135deg,var(--indigo),var(--violet));border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:24px}
#nl-modal h2{font-family:var(--font-display);font-size:22px;font-weight:700;color:var(--slate-900);margin-bottom:6px}
#nl-modal p.sub{color:var(--slate-500);font-size:14px;line-height:1.6;margin-bottom:26px;font-family:var(--font-primary)}
#nl-form{display:flex;flex-direction:column;gap:12px}
#nl-form input{font-family:var(--font-primary);background:var(--slate-100);border:1px solid rgba(29,36,51,.1);border-radius:999px;padding:14px 20px;font-size:14px;color:var(--slate-900);outline:none;transition:border .2s}
#nl-form input:focus{border-color:var(--indigo)}
#nl-form input::placeholder{color:var(--slate-400)}
#nl-form button{font-family:var(--font-display);background:var(--indigo);border:none;border-radius:999px;padding:14px;font-size:15px;font-weight:700;color:#fff;cursor:pointer;transition:background .2s}
#nl-form button:hover{background:var(--deep-indigo)}
#nl-form button:disabled{opacity:.5;cursor:not-allowed}
#nl-msg{font-size:13px;margin-top:14px;min-height:22px;font-family:var(--font-primary)}
#nl-msg.ok{color:var(--indigo);font-weight:600}
#nl-msg.err{color:#ef4444}

.nav-links a:hover,.nav-links a.active{color:#1e293b;background:rgba(30,41,59,.06)}

.cert-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px;margin-top:32px}
.cert-card{display:block;background:#fff;border:1px solid var(--slate-200);border-radius:20px;padding:32px;text-decoration:none;transition:.2s}
.cert-card:hover{border-color:var(--indigo);box-shadow:0 8px 24px rgba(102,126,234,.12);transform:translateY(-2px)}
.cert-badge{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#fff;background:var(--indigo);border-radius:999px;padding:4px 12px;margin-bottom:16px}
.cert-title{font-size:var(--text-lg);font-weight:700;color:var(--slate-900);margin-bottom:8px;line-height:1.4}
.cert-desc{font-size:var(--text-sm);color:var(--slate-500);line-height:1.6;margin-bottom:16px}
.cert-link{font-size:var(--text-sm);font-weight:600;color:var(--indigo)}
.cert-link:hover{text-decoration:underline}

</style>

<script is:inline type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Rohit Kumar Bhandari",
    "url": "https://rohitbhandariwork.github.io",
    "jobTitle": "Azure Data Engineer",
    "knowsAbout": ["Azure", "Data Architecture", "Data Engineering", "Data Factory", "Databricks"],
    "sameAs": ["https://github.com/rohitbhandariwork"]
}
</script>
