---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/topbar/TopbarApp.astro';
import Footer from '../components/footer/Footer.astro';
import contentHtml from '../content/pages/shop.html?raw';
---
<BaseLayout title="Shop — Rohit Builds">
  <Topbar slot="topbar" variant="shop" backHref="/" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<style>

/* ── Hero ── */
.hero { text-align: center; padding: clamp(48px, 10vw, 80px) 24px clamp(40px, 8vw, 60px); background: linear-gradient(180deg, var(--slate-50) 0%, var(--white) 100%); }
.hero-eyebrow { font-size: 14px; font-weight: 600; color: var(--indigo); text-transform: uppercase; letter-spacing: .02em; margin-bottom: 12px; }
.hero h1 { font-size: clamp(36px, 7vw, 64px); font-weight: 800; letter-spacing: -.025em; line-height: 1.1; color: var(--dark); max-width: 800px; margin: 0 auto 16px; }
.hero p { font-size: clamp(16px, 4vw, 19px); color: var(--slate-500); max-width: 560px; margin: 0 auto; line-height: 1.5; }

/* ── Payment Card ── */
.payment-card { max-width: 480px; margin: 40px auto 0; background: var(--white); border-radius: var(--radius-xl); padding: 32px; box-shadow: var(--shadow-md); border: 1px solid var(--slate-200); }
.payment-label { font-size: 13px; font-weight: 600; color: var(--slate-400); text-transform: uppercase; letter-spacing: .02em; margin-bottom: 8px; }
.payment-value { font-size: 28px; font-weight: 700; color: var(--dark); letter-spacing: -.01em; word-break: break-all; }
.payment-hint { font-size: 13px; color: var(--slate-400); margin-top: 12px; line-height: 1.5; }

/* ── Content ── */
.content { max-width: 1080px; margin: 0 auto; padding: 64px 24px 80px; }
.section-header { text-align: center; margin-bottom: 48px; }
.section-header h2 { font-size: clamp(28px, 5vw, 32px); font-weight: 700; letter-spacing: -.02em; margin-bottom: 8px; }
.section-header p { font-size: 17px; color: var(--slate-500); }

/* ── Product Grid (mobile-first) ── */
.product-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
@media (min-width: 600px) { .product-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
@media (min-width: 900px) { .product-grid { grid-template-columns: repeat(3, 1fr); } }

/* ── Product Card ── */
.product-card { background: var(--white); border-radius: var(--radius-xl); padding: 28px 24px; display: flex; flex-direction: column; transition: transform .2s ease, box-shadow .2s ease; border: 1px solid var(--slate-200); }
.product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.product-illustration { width: 100%; aspect-ratio: 4/3; border-radius: var(--radius-lg); background: var(--slate-50); border: 1px solid var(--slate-200); overflow: hidden; margin-bottom: 20px; }
.product-illustration img { width: 100%; height: 100%; object-fit: cover; display: block; }
.product-card h3 { font-size: 17px; font-weight: 600; letter-spacing: -.01em; color: var(--dark); margin-bottom: 8px; line-height: 1.3; }
.product-subtitle { font-size: 12px; font-weight: 600; color: var(--indigo); margin-bottom: 8px; text-transform: uppercase; letter-spacing: .02em; }
.product-card p { font-size: 14px; color: var(--slate-500); line-height: 1.55; flex: 1; margin-bottom: 20px; }
.product-footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
.product-price { font-size: 20px; font-weight: 700; color: var(--dark); }
.product-price span { font-size: 13px; font-weight: 500; color: var(--slate-400); display: block; margin-top: 2px; }

/* ── Modal ── */
.modal-backdrop { display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(0,0,0,.4); backdrop-filter: blur(8px); align-items: center; justify-content: center; padding: 24px; }
.modal-backdrop.open { display: flex; }
.modal { background: var(--white); border-radius: var(--radius-2xl); max-width: 440px; width: 100%; padding: 36px; position: relative; box-shadow: var(--shadow-xl); }
.modal-close { position: absolute; top: 16px; right: 16px; }
.modal h2 { font-size: 22px; font-weight: 700; letter-spacing: -.02em; margin-bottom: 4px; color: var(--dark); }
.modal-sub { font-size: 14px; color: var(--slate-500); margin-bottom: 24px; }
.field { margin-bottom: 16px; }
.field label { display: block; font-size: 13px; font-weight: 600; color: var(--dark); margin-bottom: 6px; }
.field input { width: 100%; padding: 12px 16px; border: 1px solid var(--slate-200); border-radius: var(--radius-md); font-family: var(--font); font-size: 15px; background: var(--white); color: var(--dark); transition: border-color .2s, box-shadow .2s; }
.field input:focus { outline: none; border-color: var(--indigo); box-shadow: 0 0 0 4px rgba(102, 126, 234, .12); }
.field input::placeholder { color: var(--slate-400); }
.field-hint { font-size: 12px; color: var(--slate-400); margin-top: 4px; }

/* ── Payment Box ── */
.payment-box { background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-lg); padding: 16px; margin-bottom: 20px; text-align: center; }
.payment-box .pay-amount { font-size: 24px; font-weight: 800; color: var(--dark); letter-spacing: -.02em; }
.payment-box .pay-amount span { font-size: 13px; font-weight: 500; color: var(--slate-400); display: block; margin-top: 2px; }
.payment-upi { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 10px 0 4px; font-size: 17px; font-weight: 600; color: var(--dark); }
.payment-upi .btn-icon { flex-shrink: 0; }
.payment-box .btn { margin-top: 4px; }
.payment-box .field-hint { display: block; margin-top: 10px; }

/* ── Steps ── */
.steps { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 20px; font-size: 12px; font-weight: 600; color: var(--slate-400); }
.step { display: flex; align-items: center; gap: 5px; }
.step-dot { width: 22px; height: 22px; border-radius: 50%; background: var(--slate-200); color: var(--slate-500); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; }
.step.active .step-dot { background: var(--indigo); color: #fff; }
.step-arrow { color: var(--slate-300); }

/* ── Track Order ── */
.track-section { max-width: 480px; margin: 0 auto 24px; }
.track-toggle { display: block; margin: 24px auto 0; font-size: 14px; }
.track-panel { background: var(--white); border: 1px solid var(--slate-200); border-radius: var(--radius-lg); padding: 20px; margin-top: 12px; box-shadow: var(--shadow-md); }
.track-panel .field { margin-bottom: 12px; }
.track-result { margin-top: 12px; font-size: 14px; color: var(--slate-500); line-height: 1.5; text-align: center; }
.status-pill { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; padding: 6px 14px; border-radius: var(--radius-full); font-size: 13px; }
.status-pill.pending { background: rgba(245, 158, 11, .12); color: #d97706; }
.status-pill.approved { background: rgba(34, 197, 94, .12); color: #16a34a; }
.status-pill.rejected { background: rgba(239, 68, 68, .12); color: #dc2626; }

/* ── Success ── */
.success-view { display: none; text-align: center; padding: 24px 0; }
.success-icon { width: 64px; height: 64px; background: rgba(34, 197, 94, .12); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 32px; }
.success-view h3 { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
.success-view p { font-size: 14px; color: var(--slate-500); line-height: 1.5; }

/* ── Toast ── */
.toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 100000; padding: 14px 28px; border-radius: var(--radius-full); font-weight: 600; font-size: 14px; display: none; box-shadow: var(--shadow-lg); }
.toast.show { display: block; }
.toast.success { background: var(--success); color: #fff; }
.toast.error { background: var(--error); color: #fff; }

/* ── Spinner ── */
.spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: spin .6s linear infinite; vertical-align: middle; margin-right: 8px; }
@keyframes spin { to { transform: rotate(360deg); } }
  
</style>

<script is:inline>
import '../scripts/shop.js';
</script>
