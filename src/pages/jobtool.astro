---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/topbar/Topbar.astro';
import Footer from '../components/footer/Footer.astro';
import contentHtml from '../content/pages/jobtool.html?raw';
---
<BaseLayout title="Jobtool — Rohit Builds">
  <Topbar slot="topbar" active="jobtool" backHref="/" variant="jobtool" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<style>

.nav-links a:hover,.nav-links a.active{color:#1e293b;background:rgba(30,41,59,.06)}

@media(min-width:992px){}

@media(max-width:768px){.nav-dropdown.open }

/* Brand Type Scale */

    
    

    
    
    
    
    
    
    .nav-links a.active { color: #1e293b; background: rgba(30,41,59,.06); }
     }
    @media (max-width: 768px) {
      
      
      
      
    }

    .job-hero {
      text-align: center; padding: 48px 24px 32px;
      background: linear-gradient(135deg, #1e293b 0%, #2a3f7a 100%);
      color: #fff;
    }
    .job-hero h1 { font-family: 'Manrope', sans-serif; font-size: 36px; font-weight: 800; letter-spacing: -0.5px; }
    .job-hero p { font-size: 16px; color: #c8d0e0; margin-top: 8px; max-width: 600px; margin-left: auto; margin-right: auto; }

    .container { max-width: 680px; margin: 0 auto; padding: 0 20px; }

    .toggle-wrap {
      display: flex; gap: 0; margin: 24px auto 0;
      background: #e8e4de; border-radius: 999px; padding: 3px;
      max-width: 360px;
    }
    .toggle-btn {
      flex: 1; padding: 10px 20px; border: none; border-radius: 999px;
      font-family:'Manrope',-apple-system,system-ui,sans-serif; font-size: 14px; font-weight: 600;
      cursor: pointer; transition: .2s; background: transparent; color: #64748b;
    }
    .toggle-btn.active { background: #1e293b; color: #fff; box-shadow: 0 2px 8px rgba(31,47,95,.2); }
    .toggle-btn:hover:not(.active) { color: #1e293b; }

    .form-card {
      background: rgba(255,255,255,0.7); backdrop-filter: blur(16px);
      border-radius: 16px; border: 1px solid rgba(0,0,0,.06);
      padding: 32px; margin: 24px auto 32px;
    }
    .form-card h2 {
      font-family: 'Manrope', sans-serif; font-size: 20px; color: #1e293b; margin-bottom: 4px;
    }
    .form-card .form-sub {
      font-size: 13px; color: #64748b; margin-bottom: 24px;
    }

    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; color: #1e293b; margin-bottom: 5px; }
    .form-group textarea, .form-group input {
      width: 100%; padding: 12px 16px; border: 1px solid #d4d8dd;
      border-radius: 10px; font-family:'Manrope',-apple-system,system-ui,sans-serif; font-size: 14px;
      background: #fff; color: #1e293b; transition: border .2s, box-shadow .2s;
    }
    .form-group textarea:focus, .form-group input:focus {
      outline: none; border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,.15);
    }
    .form-group textarea { resize: vertical; min-height: 200px; }
    .form-group .hint { font-size: 12px; color: #94a3b8; margin-top: 4px; }
    .form-group .filled-hint { font-size: 12px; color: #065f46; margin-top: 4px; display: flex; align-items: center; gap: 4px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    .extra-fields { display: none; }
    .extra-fields.visible { display: block; }

    /* .btn-primary from buttons.css — jobtool overrides below */
    .btn-submit {
      width: 100%; padding: 14px 24px; background: #f59e0b; color: #fff;
      border: none; border-radius: 999px; font-family:'Manrope',-apple-system,system-ui,sans-serif;
      font-size: 15px; font-weight: 700; cursor: pointer; transition: background .2s;
    }
    .btn-submit:hover { background: #d97706; }
    .btn-submit:disabled { background: #94a3b8; cursor: not-allowed; }

    .result-card {
      display: none; background: rgba(255,255,255,0.7); backdrop-filter: blur(16px);
      border-radius: 16px; border: 1px solid rgba(0,0,0,.06);
      padding: 32px; margin: 32px auto; text-align: center;
    }
    .result-card h3 { font-family: 'Manrope', sans-serif; font-size: 20px; color: #065f46; margin-bottom: 8px; }
    .result-card p { color: #64748b; font-size: 14px; }
    /* .btn-gray from buttons.css — used for "Apply for Another" */

    .spinner {
      display: inline-block; width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
      border-radius: 50%; animation: spin .6s linear infinite;
      vertical-align: middle; margin-right: 6px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .toast {
      position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
      z-index: 100000; padding: 14px 24px; border-radius: 999px;
      font-weight: 600; font-size: 14px; display: none;
      box-shadow: 0 4px 16px rgba(0,0,0,.15);
    }
    .toast.success { background: #065f46; color: #fff; display: block; }
    .toast.error { background: #991b1b; color: #fff; display: block; }

    @media (max-width: 640px) {
      .job-hero h1 { font-size: 28px; }
      .job-hero { padding: 32px 16px 24px; }
      .form-card { padding: 24px; }
      .form-row { grid-template-columns: 1fr; }
    }
  
</style>

<script is:inline>
import '../scripts/jobtool.js';
</script>
