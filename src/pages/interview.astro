---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/topbar/TopbarApp.astro';
import Footer from '../components/footer/Footer.astro';
import contentHtml from '../content/pages/interview.html?raw';
---
<BaseLayout title="Interview — Rohit Builds">
  <Topbar slot="topbar" variant="interview" backHref="/" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<style>

/* ── Topbar ── */
    

    
    

    
    
    

    
    
    
    

    @media (min-width: 992px) {  }
    @media (max-width: 768px) {
      
      
      
      
      
      .nav-dropdown.open 
      
    }

    /* ── Hero ── */
    .hero {
      text-align: center;
      padding: 72px 24px 56px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: #fff;
    }
    .hero-icon {
      width: 72px;
      height: 72px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
      font-size: 36px;
      backdrop-filter: blur(8px);
    }
    .hero h1 {
      font-size: clamp(32px, 6vw, 48px);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
      line-height: 1.1;
    }
    .hero p {
      font-size: 17px;
      color: rgba(255, 255, 255, 0.85);
      max-width: 520px;
      margin: 0 auto;
      line-height: 1.6;
    }
    .hero-badge {
      display: inline-block;
      margin-top: 20px;
      padding: 8px 20px;
      border-radius: var(--radius-full);
      font-size: 13px;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      backdrop-filter: blur(8px);
    }

    /* ── Container ── */
    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* ── Start Screen ── */
    .start-screen {
      text-align: center;
      padding: 64px 20px;
    }
    .start-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, var(--accent), var(--accent-dark));
      border-radius: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 28px;
      font-size: 40px;
      box-shadow: 0 8px 24px rgba(102, 126, 234, 0.35);
    }
    .start-screen h2 {
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 12px;
      letter-spacing: -0.01em;
    }
    .start-screen > p {
      color: var(--text-secondary);
      font-size: 16px;
      max-width: 460px;
      margin: 0 auto;
      line-height: 1.6;
    }
    .focus-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin: 28px 0;
    }
    .focus-tag {
      padding: 10px 18px;
      border-radius: var(--radius-full);
      font-size: 14px;
      font-weight: 600;
      background: var(--bg);
      color: var(--text-primary);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }
    .start-hint {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: -8px;
      margin-bottom: 28px;
    }
    /* .btn-primary from buttons.css — interview-specific overrides below */
    .btn-start:disabled {
      background: var(--text-muted);
      cursor: not-allowed;
      box-shadow: none;
      transform: none;
    }

    /* ── Progress ── */
    .progress-section { margin: 28px 0 16px; }
    .progress-label {
      text-align: center;
      font-size: 13px;
      color: var(--text-secondary);
      font-weight: 600;
      margin-bottom: 10px;
    }
    .progress-track {
      background: var(--border);
      border-radius: var(--radius-full);
      height: 6px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), #764ba2);
      border-radius: var(--radius-full);
      transition: width .4s ease;
      width: 0%;
    }

    /* ── Timer ── */
    .timer-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin: 14px 0;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-secondary);
    }
    .timer-ring {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2.5px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      color: var(--text-secondary);
      transition: all .3s;
    }
    .timer-ring.warn { border-color: var(--amber); color: #d97706; }
    .timer-ring.danger { border-color: #ef4444; color: #ef4444; animation: pulse .5s infinite; }
    @keyframes pulse { 50% { opacity: .5; } }

    /* ── Chat ── */
    .chat-box {
      background: var(--bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      padding: 24px;
      margin: 20px 0;
      max-height: 520px;
      overflow-y: auto;
      box-shadow: var(--shadow-sm);
    }
    .chat-box::-webkit-scrollbar { width: 4px; }
    .chat-box::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }

    .msg {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
      animation: fadeIn .3s ease;
    }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    .msg-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
    }
    .msg-avatar.ai { background: var(--accent); color: #fff; }
    .msg-avatar.user { background: var(--amber); color: #fff; }

    .msg-bubble {
      background: var(--bg-secondary);
      padding: 16px 20px;
      border-radius: var(--radius);
      font-size: 15px;
      line-height: 1.7;
      color: var(--text-primary);
      flex: 1;
      font-family: var(--font-reading);
    }
    .msg.user-msg .msg-bubble { background: var(--accent-light); }

    .area-tag {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: var(--radius-full);
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }
    .area-tag.python { background: #dcfce7; color: #166534; }
    .area-tag.concurrency { background: #fed7aa; color: #9a3412; }
    .area-tag.react { background: #dbeafe; color: #1e40af; }
    .area-tag.sql { background: #f3e8ff; color: #7e22ce; }

    .eval-section {
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
    }
    .eval-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 5px 12px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 700;
    }
    .eval-badge.good { background: #dcfce7; color: #166534; }
    .eval-badge.ok { background: #fed7aa; color: #9a3412; }
    .eval-badge.needs-work { background: #fee2e2; color: #991b1b; }
    .eval-text { font-size: 14px; color: var(--text-secondary); margin-top: 8px; line-height: 1.6; }
    .eval-tip { font-size: 13px; color: #d97706; margin-top: 6px; }

    /* ── Typing Indicator ── */
    .typing {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 0 4px 48px;
      font-size: 13px;
      color: var(--text-muted);
    }
    .typing-dot {
      width: 6px;
      height: 6px;
      background: var(--text-muted);
      border-radius: 50%;
      animation: bounce 1.4s infinite;
    }
    .typing-dot:nth-child(2) { animation-delay: .2s; }
    .typing-dot:nth-child(3) { animation-delay: .4s; }
    @keyframes bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }

    /* ── Input ── */
    .input-area {
      display: flex;
      gap: 10px;
      margin: 0 0 40px;
    }
    .input-area textarea {
      flex: 1;
      padding: 14px 18px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      font-family: var(--font-primary);
      font-size: 15px;
      resize: none;
      height: 56px;
      background: var(--bg);
      color: var(--text-primary);
      transition: border .2s, box-shadow .2s;
    }
    .input-area textarea:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.12);
    }
    .input-area textarea::placeholder { color: var(--text-muted); }
    .input-area button {
      width: 52px;
      height: 56px;
      border: none;
      border-radius: var(--radius);
      background: var(--accent);
      color: #fff;
      font-size: 18px;
      cursor: pointer;
      transition: background .2s;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .input-area button:hover { background: var(--accent-dark); }
    .input-area button:disabled { background: var(--text-muted); cursor: not-allowed; }

    /* ── Results ── */
    .result-card {
      display: none;
      background: var(--bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      padding: 40px 32px;
      margin: 32px 0 48px;
      box-shadow: var(--shadow-md);
    }
    .result-card h3 {
      font-size: 24px;
      font-weight: 800;
      margin-bottom: 8px;
      letter-spacing: -0.01em;
    }
    .result-card .subtitle {
      color: var(--text-secondary);
      font-size: 15px;
      margin-bottom: 28px;
    }
    .score-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 28px;
    }
    .score-item {
      background: var(--bg-secondary);
      padding: 18px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }
    .score-item .label {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .03em;
    }
    .score-item .value {
      font-size: 28px;
      font-weight: 800;
      margin-top: 6px;
    }
    .summary-text {
      font-size: 15px;
      line-height: 1.7;
      color: var(--text-secondary);
      margin-bottom: 28px;
      white-space: pre-wrap;
      font-family: var(--font-reading);
    }
    /* .btn-gray from buttons.css */

    /* ── Toast ── */
    .toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 100000;
      padding: 14px 28px;
      border-radius: var(--radius-full);
      font-weight: 600;
      font-size: 14px;
      display: none;
      box-shadow: var(--shadow-lg);
    }
    .toast.show { display: block; }
    .toast.error { background: #ef4444; color: #fff; }

    .spinner {
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .6s linear infinite;
      vertical-align: middle;
      margin-right: 8px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  
</style>

<script is:inline>
import '../scripts/interview.js';
</script>
