---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Topbar from '../../components/topbar/Topbar.astro';
import Footer from '../../components/footer/Footer.astro';
import contentHtml from '../../content/pages/courses.html?raw';
---
<BaseLayout title="Courses — Rohit Builds">
  <Topbar slot="topbar" active="courses" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<style>

.main { max-width: 640px; margin: 0 auto; padding: 24px 20px 60px; }
.hero { background: var(--gradient-brand); border-radius: 24px; padding: 48px 24px; text-align: center; color: #fff; margin-bottom: 32px; position: relative; overflow: hidden; }
.hero::before { content: ''; position: absolute; top: -40%; right: -20%; width: 250px; height: 250px; background: rgba(255,255,255,.08); border-radius: 50%; }
.hero h1 { font-size: clamp(28px,5vw,40px); font-weight: 800; letter-spacing: -.02em; position: relative; }
.hero p { font-size: 16px; color: rgba(255,255,255,.85); margin-top: 12px; line-height: 1.6; max-width: 480px; margin-left: auto; margin-right: auto; position: relative; }
.section-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--indigo); margin-bottom: 12px; padding-left: 4px; }
.course-list { display: grid; grid-template-columns: 1fr; gap: 12px; }
.course-card { background: #fff; border: 2px solid var(--slate-200); border-radius: 16px; padding: 20px; text-decoration: none; transition: .2s; display: flex; align-items: center; gap: 16px; }
.course-card:active { transform: scale(.98); }
.course-card:hover { border-color: var(--indigo); box-shadow: 0 4px 12px rgba(102,126,234,.15); }
.course-icon { font-size: 32px; flex-shrink: 0; width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; border-radius: 14px; background: var(--slate-100); }
.course-info { flex: 1; }
.course-name { font-size: 18px; font-weight: 800; color: var(--slate-900); }
.course-desc { font-size: 12px; color: var(--slate-500); margin-top: 2px; line-height: 1.4; }
.course-arrow { font-size: 20px; color: var(--slate-400); flex-shrink: 0; }

</style>
