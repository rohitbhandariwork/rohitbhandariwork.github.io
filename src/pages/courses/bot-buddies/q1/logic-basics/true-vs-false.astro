---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Topbar from '../../../../../components/topbar/Topbar.astro';
import Footer from '../../../../../components/footer/Footer.astro';
import contentHtml from '../../../../../content/pages/true-vs-false.html?raw';
---
<BaseLayout title="True or False — Rohit Builds">
  <Topbar slot="topbar" active="courses" backHref="/courses/bot-buddies/" variant="quiz" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<style>

:root {
      --color: #f472b6;
      --color2: #fbbf24;
      --bg: #fdf2f8;
      --error: #ef4444;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    

    
/* ── Layout ── */
    .main { max-width: 720px; margin: 0 auto; padding: 24px 20px 60px; }

    /* ── Hero ── */
    .hero {
      background: linear-gradient(135deg, var(--color), var(--color2));
      border-radius: 24px; padding: 48px 24px; text-align: center; color: #fff;
      margin-bottom: 32px; position: relative; overflow: hidden;
    }
    .hero::before { content: ''; position: absolute; top: -50%; right: -30%; width: 300px; height: 300px; background: rgba(255,255,255,.08); border-radius: 50%; }
    .hero-emoji { font-size: 80px; margin-bottom: 16px; position: relative; }
    .hero h1 { font-size: clamp(28px, 5vw, 40px); font-weight: 800; letter-spacing: -.02em; position: relative; }
    .hero .tagline { display: inline-block; margin-top: 8px; padding: 6px 16px; background: rgba(255,255,255,.15); border-radius: 999px; font-size: 13px; font-weight: 700; backdrop-filter: blur(8px); position: relative; }

    /* ── Gamification Bar ── */
    .gamification-bar { display: flex; align-items: center; gap: 12px; background: var(--surface); border: 1px solid var(--border-light); border-radius: 12px; padding: 12px 16px; margin-bottom: 24px; }
    .gf-item { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: var(--text); white-space: nowrap; }
    .gf-icon { font-size: 16px; }
    .gf-xp-wrap { flex: 1; min-width: 80px; }
    .gf-xp-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-secondary); margin-bottom: 4px; }
    .gf-xp-bar { background: var(--border-light); border-radius: 999px; height: 8px; overflow: hidden; }
    .gf-xp-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--color), var(--color2)); transition: width .5s ease; width: 0%; }
    .gf-level { background: linear-gradient(135deg, var(--color), var(--color2)); border-radius: 999px; padding: 4px 12px; font-size: 12px; font-weight: 800; color: #fff; }

    /* ── Game Container ── */
    .game-card {
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: 20px;
      padding: 24px;
      margin-bottom: 24px;
    }
    .question-emoji { font-size: 80px; text-align: center; margin: 20px 0; }
    .question-text { 
      font-size: 24px; font-weight: 800; text-align: center; 
      color: var(--text); margin-bottom: 32px;
      font-family: var(--font);
    }
    .answer-buttons { display: flex; gap: 16px; justify-content: center; }
    .answer-btn {
      flex: 1; max-width: 160px; padding: 20px; border-radius: 16px;
      border: none; cursor: pointer; transition: .2s;
      display: flex; flex-direction: column; align-items: center; gap: 8px;
    }
    .answer-btn:hover { transform: scale(1.02); }
    .answer-btn:active { transform: scale(0.98); }
    .answer-btn.true { background: var(--success); color: #fff; }
    .answer-btn.false { background: var(--error); color: #fff; }
    .answer-emoji { font-size: 36px; }
    .answer-label { font-size: 16px; font-weight: 700; font-family: var(--font); }

    /* ── Feedback ── */
    .feedback {
      position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(100px);
      padding: 16px 32px; border-radius: 16px; font-size: 18px; font-weight: 700;
      font-family: var(--font); z-index: 99999; transition: transform .3s ease;
      pointer-events: none;
    }
    .feedback.show { transform: translateX(-50%) translateY(0); }
    .feedback.correct { background: var(--success); color: #fff; }
    .feedback.incorrect { background: var(--error); color: #fff; }

    /* ── Progress ── */
    .progress-dots { display: flex; justify-content: center; gap: 8px; margin-bottom: 24px; }
    .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--border-light); transition: .2s; }
    .dot.active { background: var(--color); transform: scale(1.2); }
    .dot.complete { background: var(--success); }

    /* ── Complete Screen ── */
    .complete-screen { text-align: center; padding: 40px 20px; }
    .complete-emoji { font-size: 80px; margin-bottom: 16px; }
    .complete-title { font-size: 28px; font-weight: 800; color: var(--text); margin-bottom: 8px; }
    .complete-score { font-size: 18px; color: var(--text-secondary); margin-bottom: 24px; }
    .complete-buttons { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  
</style>
