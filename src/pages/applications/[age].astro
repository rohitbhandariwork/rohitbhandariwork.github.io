---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Topbar from '../../components/topbar/Topbar.astro';
import Footer from '../../components/footer/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { age: '4-7' }, props: { title: 'Ages 4–7', subtitle: 'Bot Buddies', emoji: '👶', color: '#f472b6', color2: '#fbbf24', activities: [
      { icon: '🎬', name: 'Scratch.Jr', desc: 'Create animated stories and interactive games' },
      { icon: '🤖', name: 'Bot Builders', desc: 'Assemble and program simple robots' },
      { icon: '🎨', name: 'Digital Art', desc: 'Draw, animate, and share creations' },
    ], cta: 'Start Playing' } },
    { params: { age: '8-11' }, props: { title: 'Ages 8–11', subtitle: 'Code Kids', emoji: '🧒', color: '#34d399', color2: '#60a5fa', activities: [
      { icon: '🐱', name: 'Scratch', desc: 'Create games, stories, and animations with code' },
      { icon: '🤖', name: 'Robotics', desc: 'Build and program real robots' },
      { icon: '🌐', name: 'Web Basics', desc: 'Create your first website' },
    ], cta: 'Take the Challenge' } },
    { params: { age: '12-15' }, props: { title: 'Ages 12–15', subtitle: 'Code Quest', emoji: '🧑', color: '#f59e0b', color2: '#ef4444', activities: [
      { icon: '💻', name: 'Small Coding Projects', desc: 'Build real apps and games' },
      { icon: '🐍', name: 'Python', desc: 'Learn the language of AI and automation' },
      { icon: '🎮', name: 'Game Dev', desc: 'Create your own video games' },
    ], cta: 'Level Up' } },
    { params: { age: '15-17' }, props: { title: 'Ages 15–17', subtitle: 'AI Lab', emoji: '🎓', color: '#8b5cf6', color2: '#06b6d4', activities: [
      { icon: '🏆', name: 'Competitions', desc: 'Compete in hackathons and coding contests' },
      { icon: '🧠', name: 'Machine Learning', desc: 'Train your own AI models' },
      { icon: '📱', name: 'Full-Stack', desc: 'Build complete web applications' },
    ], cta: 'Get Started' } },
    { params: { age: '18+' }, props: { title: 'Ages 18+', subtitle: 'Career Launcher', emoji: '💼', color: '#667eea', color2: '#764ba2', activities: [
      { icon: '📚', name: 'Knowledge Vault', desc: 'AI-powered learning paths' },
      { icon: '🎤', name: 'Interview Prep', desc: 'AI mock interviews with real-time feedback' },
      { icon: '📝', name: 'Job Tool', desc: 'AI resume builder and job matcher' },
    ], cta: 'Start Learning' } },
  ];
}

const { title, subtitle, emoji, color, color2, activities, cta } = Astro.props;
---
<BaseLayout title={`${title} — Rohit Builds`}>
  <Topbar slot="topbar" active="applications" />

  <section class="app-hero" style={`--color: ${color}; --color2: ${color2}`}>
    <div class="app-hero-content">
      <span class="app-emoji">{emoji}</span>
      <h1>{title}</h1>
      <p class="app-subtitle">{subtitle}</p>
      <a href={`/courses/${subtitle.toLowerCase().replace(' ', '-')}/`} class="btn btn-primary btn-lg">{cta}</a>
    </div>
  </section>

  <section class="section">
    <div class="section-label">What You'll Do</div>
    <div class="activities">
      {activities.map((a) => (
        <div class="activity">
          <div class="icon">{a.icon}</div>
          <div>
            <div class="name">{a.name}</div>
            <div class="desc">{a.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>


