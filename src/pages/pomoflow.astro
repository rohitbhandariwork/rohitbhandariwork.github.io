---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/topbar/Topbar.astro';
import Footer from '../components/footer/Footer.astro';
import contentHtml from '../content/pages/pomoflow.html?raw';
---
<BaseLayout title="Pomoflow">
  <Topbar slot="topbar" active="pomoflow" variant="pomoflow" backHref="/" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<script>
  import '../scripts/pomoflow.js';
</script>