---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/topbar/TopbarApp.astro';
import Footer from '../components/footer/Footer.astro';
import contentHtml from '../content/pages/pomoflow.html?raw';
---
<BaseLayout title="Pomoflow — Rohit Builds">
  <Topbar slot="topbar" variant="pomoflow" backHref="/" />
  <div set:html={contentHtml} />
  <Footer slot="footer" />
</BaseLayout>

<style>

    /* ── Stats Hero ── */
    .stats-hero {
      background: linear-gradient(135deg, #e0e7ff 0%, #fce7f3 50%, #d1fae5 100%);
      padding: 14px 16px;
    }
    .stats-grid { display: flex; align-items: center; gap: 10px; max-width: 640px; margin: 0 auto; }
    .level-badge {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: linear-gradient(135deg, #fff, #f1f5f9);
      border: 1px solid rgba(0,0,0,.08);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .lvl-num {
      font-size: 22px;
      font-weight: 900;
      line-height: 1;
      background: linear-gradient(135deg, var(--amber), #ec4899);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .lvl-label { font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--text-secondary); margin-top: 1px; }
    .stats-main { flex: 1; min-width: 0; }
    .stats-row1 { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .stats-row1 .title { font-size: 13px; font-weight: 800; color: var(--purple); white-space: nowrap; }
    .stats-row1 .xp-text { font-size: 11px; font-weight: 700; color: var(--text-secondary); white-space: nowrap; }
    .xp-bar-wrap { height: 5px; background: rgba(0,0,0,.06); border-radius: 4px; margin-top: 4px; overflow: hidden; }
    .xp-bar-fill { height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--amber), #ec4899); transition: width .5s ease; width: 0%; }
    .stats-right { display: flex; gap: 6px; flex-shrink: 0; }
    .stat-pill {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 6px 10px;
      border-radius: 10px;
      background: rgba(255,255,255,.7);
      border: 1px solid rgba(0,0,0,.06);
      min-width: 48px;
    }
    .stat-pill .stat-num { font-size: 14px; font-weight: 800; line-height: 1.2; }
    .stat-pill .stat-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; color: var(--text-secondary); }
    .stat-pill.streak .stat-num { color: #f97316; }
    .stat-pill.streak.has-streak { background: rgba(249,115,22,.12); border-color: rgba(249,115,22,.25); }
    .stat-pill.pomodoros .stat-num { color: var(--red); }
    .days-chips { display: flex; gap: 3px; margin-top: 6px; }
    .day-chip { width: 28px; height: 28px; border-radius: 6px; background: #e2e8f0; font-size: 10px; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #94a3b8; transition: .3s; }
    .day-chip.done { background: #22c55e; color: #fff; }
    .day-chip.today { box-shadow: 0 0 6px rgba(245,158,11,.4); }
    .day-chip.missed { background: var(--red); color: #fff; }
    .stats-footer { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 8px; }
    .stats-footer span { font-size: 11px; color: var(--text-secondary); }
    .stats-footer strong { color: var(--purple); }

    /* ── Timer Section ── */
    .container { max-width: 640px; margin: 0 auto; padding: 0 16px; }
    .timer-section { padding: 24px 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .timer-ring-wrap { position: relative; width: 260px; height: 260px; touch-action: manipulation; }
    .timer-ring-svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .timer-ring-bg { fill: none; stroke: var(--border); stroke-width: 6; }
    .timer-ring-progress { fill: none; stroke: var(--purple); stroke-width: 6; stroke-linecap: round; transition: stroke-dashoffset .5s ease, stroke .5s ease; }
    .timer-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; }
    .timer-phase { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--text-secondary); }
    .timer-phase.focus { color: var(--purple); }
    .timer-phase.break { color: var(--green); }
    .timer-display { font-size: 52px; font-weight: 800; letter-spacing: 2px; font-variant-numeric: tabular-nums; line-height: 1; color: var(--text); }
    .timer-duration-badge { font-size: 11px; font-weight: 600; color: var(--text-muted); letter-spacing: .5px; }
    .timer-duration-badge strong { color: var(--text); font-weight: 800; }

    /* ── Controls ── */
    .timer-controls { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
    .timer-controls .btn:active { transform: scale(.95); }

    /* ── Toggles ── */
    .toggle-row { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }

    /* ── Effects ── */
    .flash-overlay { position: fixed; inset: 0; pointer-events: none; z-index: 9999; transition: opacity .3s; opacity: 0; }
    .flash-overlay.show { opacity: 1; }
    .flash-overlay.flash-focus { background: rgba(124,58,237,.08); }
    .flash-overlay.flash-break { background: rgba(5,150,105,.08); }
    .flash-overlay.flash-complete { background: rgba(236,72,153,.12); }
    .confetti-container { position: fixed; inset: 0; pointer-events: none; z-index: 9998; overflow: hidden; }
    .confetti-piece { position: absolute; width: 8px; height: 8px; border-radius: 2px; animation: confettiFall linear forwards; }
    @keyframes confettiFall { 0% { transform: translateY(-10px) rotate(0deg); opacity: 1; } 100% { transform: translateY(100vh) rotate(720deg); opacity: 0; } }
    .float-xp { position: fixed; font-weight: 900; font-size: 24px; pointer-events: none; z-index: 10000; animation: floatUp 1.2s ease forwards; text-shadow: 0 0 12px currentColor; }
    @keyframes floatUp { 0% { transform: translateY(0) scale(.5); opacity: 1; } 100% { transform: translateY(-120px) scale(1.2); opacity: 0; } }

    /* ── Toast ── */
    .toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); padding: 12px 24px; border-radius: var(--radius); font-family: var(--font); font-size: 13px; font-weight: 700; z-index: 9999; opacity: 0; transition: opacity .3s ease, transform .3s ease; pointer-events: none; white-space: nowrap; }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(-4px); }
    .toast.success { background: rgba(5,150,105,.12); color: var(--green); border: 1px solid rgba(5,150,105,.2); }
    .toast.xp { background: rgba(124,58,237,.12); color: var(--purple); border: 1px solid rgba(124,58,237,.2); }
    .toast.info { background: rgba(59,130,246,.15); color: #3b82f6; border: 1px solid rgba(59,130,246,.2); }
    .toast.error { background: rgba(239,68,68,.15); color: var(--red); border: 1px solid rgba(239,68,68,.2); }
    .toast.warning { background: rgba(168,85,247,.15); color: #a855f7; border: 1px solid rgba(168,85,247,.2); }

    /* ── Modal ── */
    .modal-overlay { position: fixed; inset: 0; z-index: 200000; display: none; align-items: center; justify-content: center; background: rgba(0,0,0,.5); backdrop-filter: blur(4px); }
    .modal-overlay.show { display: flex; }
    .modal-box { background: #fff; border-radius: 24px; padding: 32px 24px; max-width: 340px; text-align: center; box-shadow: 0 0 60px rgba(99,102,241,.1); border: 1px solid var(--border); animation: modalIn .4s cubic-bezier(.4,0,.2,1); }
    @keyframes modalIn { 0% { transform: scale(.8); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
    .modal-box .big-lvl { font-size: 56px; font-weight: 900; background: linear-gradient(135deg, var(--amber), var(--red)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1; }
    .modal-box .big-lvl-title { font-size: 20px; font-weight: 800; color: var(--text); margin-top: 8px; }
    .modal-box .big-lvl-desc { font-size: 13px; color: var(--text-secondary); margin-top: 8px; line-height: 1.5; }

    /* ── Responsive ── */
    @media (min-width: 768px) {
      .stats-hero { padding: 16px 24px; }
      .timer-ring-wrap { width: 300px; height: 300px; }
      .timer-display { font-size: 64px; }
    }
    @media (min-width: 1024px) {
      .stats-hero { padding: 20px 32px; }
      .level-badge { width: 64px; height: 64px; }
      .lvl-num { font-size: 26px; }
      .stats-row1 .title { font-size: 14px; }
      .stat-pill { padding: 8px 14px; min-width: 52px; }
      .stat-pill .stat-num { font-size: 18px; }
      .day-chip { width: 32px; height: 32px; font-size: 11px; }
      .timer-ring-wrap { width: 340px; height: 340px; }
      .timer-display { font-size: 72px; }
      .timer-phase { font-size: 14px; }
      .timer-controls .btn { padding: 16px 40px; font-size: 17px; }
    }
  
</style>

<script is:inline>
import '../scripts/pomoflow.js';
</script>
