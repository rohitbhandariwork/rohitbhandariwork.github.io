---
interface Props {
  variant?: 'flashcard' | 'pomoflow' | 'course' | 'quiz';
  backHref?: string;
}
const { variant, backHref = '/' } = Astro.props;
---
<div id="topbar">
  {backHref && <a href={backHref} class="btn-back">← Back</a>}
  <button class="hamburger" onclick="toggleNav()">☰</button>
  {variant === 'flashcard' && (
    <span class="mini-level" id="topLevel" onclick="showInsightPopup()">
      <span class="ml-num" id="topLvlNum">1</span>
      <span class="ml-gems" id="topGems">💎10</span>
    </span>
  )}
  {variant === 'pomoflow' && (
    <div class="stats-panel">
      <div class="stats-title">🍅 Pomoflow</div>
    </div>
  )}
  <div class="nav-links" id="navLinks">
    <a href="/">🏠 Home</a>
    <div class="nav-dropdown" onclick="this.classList.toggle('open')">
      <a href="javascript:void(0)">📱 Applications ▾</a>
      <div class="nav-dropdown-menu">
        <a href="/applications/4-7">👶 Ages 4–7</a>
        <a href="/applications/8-11">🧒 Ages 8–11</a>
        <a href="/applications/12-15">🧑 Ages 12–15</a>
        <a href="/applications/15-17">🎓 Ages 15–17</a>
        <a href="/applications/18+">💼 Ages 18+</a>
      </div>
    </div>
    <a href="/courses/">📚 Courses</a>
    <a href="/shop/">🛒 Shop</a>
    <a href="/news/">📰 News</a>
    <a href="/#contact">✉️ Contact</a>
  </div>
</div>
