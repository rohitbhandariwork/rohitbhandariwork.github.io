---
interface Props {
  label: string;
  items: Array<{ href: string; emoji: string; label: string }>;
}
const { label, items } = Astro.props;
---
<div class="nav-dropdown" onclick="this.classList.toggle('open')">
  <a href="javascript:void(0)">{label} ▾</a>
  <div class="nav-dropdown-menu">
    {items.map((item) => (
      <a href={item.href}>{item.emoji} {item.label}</a>
    ))}
  </div>
</div>
